export GCP_PROJECT_ID="${GCP_PROJECT_ID:-$(gcloud config get-value project 2>/dev/null || echo 'YOUR_GCP_PROJECT_ID')}"
export GCP_DOCAI_LOCATION="${GCP_DOCAI_LOCATION:-us}"
export GCP_INPUT_BUCKET="${GCP_INPUT_BUCKET:-gs://${GCP_PROJECT_ID}-sap-docai-input}"
export GCP_OUTPUT_BUCKET="${GCP_OUTPUT_BUCKET:-gs://${GCP_PROJECT_ID}-sap-docai-output}"
export GCP_BQ_DATASET="${GCP_BQ_DATASET:-sap_docai_staging}"
export GCP_BQ_TABLE="${GCP_BQ_TABLE:-extracted_sap_documents}"
export INVOICE_PROCESSOR_ID="${INVOICE_PROCESSOR_ID:-YOUR_INVOICE_PROCESSOR_ID}"
export CUSTOM_PROCESSOR_ID="${CUSTOM_PROCESSOR_ID:-YOUR_CUSTOM_PROCESSOR_ID}"
